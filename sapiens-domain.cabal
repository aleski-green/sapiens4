cabal-version: 3.0
name: sapiens-domain
version: 0.2.0.0
build-type: Simple

flag linux-desktop
  description: Build the GTK Linux desktop
  default: False
  manual: True

common runtime
  default-language: Haskell2010
  default-extensions: OverloadedStrings, ScopedTypeVariables, TupleSections
  ghc-options: -threaded -rtsopts -O1 -Wall -Werror=incomplete-patterns -Werror=incomplete-uni-patterns -Werror=missing-fields
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring, text, containers,
    directory, filepath, process, time, async, stm, scientific, vector,
    sqlite-simple, filelock, uuid, base64-bytestring, network-uri, regex-tdfa,
    http-client, http-client-tls, http-types, network, wai, warp, wai-websockets,
    websockets, wuss, cryptohash-sha256, random, tagsoup ==0.14.8
  if !os(windows)
    build-depends: unix

executable sapiens-domain
  main-is: Main.hs
  hs-source-dirs: corpora/work/schedule
  other-modules: Command, Wire
  build-depends: base >=4.18 && <5, aeson ==2.3.2.0, bytestring
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror

common host
  hs-source-dirs: corpora, corpora/state, corpora/work, corpora/work/schedule, corpora/host, remote/relay, remote/control, remote/protocol, build
  other-modules:
    Command,
    Domain,
    RuntimePaths,
    DataRoot,
    Assets,
    BuildUI,
    Computer,
    Delegation,
    Execution,
    GroupChat,
    GroupModel,
    GroupWork,
    Groups,
    HTTP,
    Management,
    Memo,
    Population,
    Provider,
    Onboarding,
    Bridge,
    Client,
    Crypto,
    Mailboxes,
    Registry,
    Receipt,
    Server,
    Setup,
    Transport,
    Routines,
    HostServer,
    Service,
    Store,
    Types,
    Voice,
    Workspace,
    Wire
  extra-lib-dirs: submodules/libs4/haskell/sodium/src/libsodium/.libs
  extra-libraries: sodium

executable sapiens4
  import: runtime, host
  main-is: Main.hs

executable sapiens-linux
  import: runtime, host
  hs-source-dirs: environments/linux
  main-is: LinuxMain.hs
  if os(linux) && flag(linux-desktop)
    c-sources: environments/linux/Desktop.c, environments/linux/Browser.c
    pkgconfig-depends: gtk+-3.0 >=3.24, webkit2gtk-4.1 >=2.40, json-glib-1.0
    cc-options: -Wall -Wextra -Werror
  else
    buildable: False

executable sapiens-macos
  import: runtime
  hs-source-dirs: environments/macos, environments, corpora/state
  other-modules:
    Domain,
    RuntimePaths,
    DataRoot,
    DesktopStorage,
    Types,
    Application,
    Browser,
    Icon,
    ObjC
  main-is: MacMain.hs
  if os(osx)
    c-sources: submodules/libs4/haskell/native/cocoa.c, environments/macos/Process.c
    frameworks: Cocoa, WebKit, CoreGraphics
    extra-libraries: objc
  else
    buildable: False

common windows-host
  import: runtime
  other-modules:
    Domain,
    RuntimePaths,
    DataRoot,
    DesktopStorage,
    Types,
    Browser,
    Host,
    Native,
    Navigation,
    Shell
  if os(windows)
    c-sources: submodules/libs4/haskell/native/windows.c
    extra-libraries: user32, ole32, dwmapi, comdlg32, kernel32
  else
    buildable: False

executable sapiens-windows
  import: windows-host
  hs-source-dirs: environments/windows, environments, corpora/state
  main-is: WindowsMain.hs
  if os(windows)
    ld-options: .build/haskell/windows-resources.o
    ghc-options: -optl-mwindows

executable sapiens-windows-probe
  import: windows-host
  hs-source-dirs: spec/support, environments/windows, environments, corpora/state
  main-is: WindowsProbeMain.hs

executable sapiens-provider
  main-is: WindowsProviderMain.hs
  hs-source-dirs: spec/support
  default-language: Haskell2010
  build-depends: base >=4.18 && <5, process
  if !os(windows)
    buildable: False

executable sapiens-peer
  main-is: Peer.hs
  hs-source-dirs: spec/support
  default-language: Haskell2010
  ghc-options: -threaded -O1 -Wall
  build-depends: base >=4.18 && <5, aeson, async, base64-bytestring, bytestring,
    containers, network-uri, stm, text, websockets, wuss
  extra-lib-dirs: submodules/libs4/haskell/sodium/src/libsodium/.libs
  extra-libraries: sodium
