<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>SapiensDesktop.AccessibilityProbe</StartupObject>
  </PropertyGroup>
  <Import Project="../../../libs4/dotnet/WebView2.props" />
  <ItemGroup>
    <Compile Include="../../../windows/*.cs" />
    <EmbeddedResource Include="../../../windows/AppIcon.ico" LogicalName="Sapiens4.AppIcon.Light" />
    <EmbeddedResource Include="../../../windows/AppIconDark.ico" LogicalName="Sapiens4.AppIcon.Dark" />
  </ItemGroup>
</Project>
